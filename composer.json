{
    "name": "yourbureau/api-client",
    "description": "PHP client for the yourBureau REST API v3",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "yourbureau",
        "api",
        "rest",
        "client"
    ],
    "homepage": "https://github.com/indual-web/indual-yourbureau-api-php-client",
    "support": {
        "source": "https://github.com/indual-web/indual-yourbureau-api-php-client",
        "docs": "https://api.yourbureau.ch/index.php/docs/api"
    },
    "authors": [
        {
            "name": "indual",
            "homepage": "https://www.indual.ch"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "YourBureau\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YourBureau\\Api\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --no-coverage"
    },
    "minimum-stability": "stable"
}
